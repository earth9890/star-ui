{
  "name": "star-ui-lib",
  "version": "0.0.2",
  "description": "A modern React UI component library built with TypeScript and Tailwind CSS",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "playground": "npm run build && cd playground && npm run dev",
    "playground:build": "cd playground && npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build"
  },
  "keywords": [
    "react",
    "typescript",
    "tailwind",
    "components",
    "ui",
    "design-system"
  ],
  "author": "Your Name",
  "license": "MIT",
